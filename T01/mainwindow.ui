  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget {
    background-color: #d5e8b3;
}

QLabel, QRadioButton {
    color: #2f3e1f;
}

QGroupBox {
    color: #2f3e1f;
    border: 1px solid #9db87a;
    border-radius: 6px;
    margin-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QPushButton {
    background-color: #5b8a3c;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton:hover {
    background-color: #6fa04a;
}
QPushButton:pressed {
    background-color: #4a7330;
}
QPushButton:disabled {
    background-color: #b7c9a0;
    color: #7d8c6a;
}

/* make the main action stand out */
QPushButton#btnExecuta {
    background-color: #d9822b;
    font-weight: bold;
}
QPushButton#btnExecuta:hover {
    background-color: #e8943f;
}</string>
